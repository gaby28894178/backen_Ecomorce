DATABASE_URL=postgres://postgres:root@127.0.0.1:5432/<nombre_DB>
JWT_SECRET=tu_secreto_aqui
JWT_EXPIRES_IN=7d
PORT=4001
# ALLOWED_ORIGINS puede usarse para restringir CORS (coma separada)
ALLOWED_ORIGINS=http://localhost:4001,http://localhost:4002

# Nota: En Vercel el puerto no aplica; configura DATABASE_URL, JWT_SECRET y JWT_EXPIRES_IN en Variables del Proyecto.
# Si tu proveedor requiere SSL (Neon/Supabase/etc), usa DATABASE_SSL=true
DATABASE_SSL=false



