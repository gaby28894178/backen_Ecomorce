{
  "info": {
    "name": "Para Tienda API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4002/api/v1" },
    { "key": "token", "value": "" },
    { "key": "usuarioId", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "carritoItemId", "value": "" },
    { "key": "email", "value": "tester@example.com" },
    { "key": "password", "value": "secret123" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (alias)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth","login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.test('Login devuelve token', function(){ pm.expect(data).to.have.property('token'); });",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); pm.collectionVariables.set('usuarioId', data.usuario && data.usuario.id); pm.collectionVariables.set('expiresIn', data.expiresIn);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (usuarios)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/usuarios/login",
              "host": ["{{baseUrl}}"],
              "path": ["usuarios","login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"email\": \"juan@example.com\",\n  \"password\": \"123456\",\n  \"role\": \"user\",\n  \"estado\": true\n}"
            }
          }
        },
        { "name": "Listar usuarios", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] } } },
        { "name": "Obtener usuario por ID", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/usuarios/{{usuarioId}}", "host": ["{{baseUrl}}"], "path": ["usuarios","{{usuarioId}}"] } } },
        {
          "name": "Actualizar nombre usuario",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/usuarios/{{usuarioId}}", "host": ["{{baseUrl}}"], "path": ["usuarios","{{usuarioId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Juan Actualizado\"\n}" }
          }
        },
        { "name": "Eliminar usuario", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/usuarios/{{usuarioId}}", "host": ["{{baseUrl}}"], "path": ["usuarios","{{usuarioId}}"] } } }
      ]
    },
    {
      "name": "Productos (protegido)",
      "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] },
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Camiseta\",\n  \"descripcion\": \"Camiseta básica\",\n  \"precio\": 19.99,\n  \"stock\": 50\n}" }
          }
        },
        { "name": "Listar productos", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/productos", "host": ["{{baseUrl}}"], "path": ["productos"] } } },
        { "name": "Obtener producto por ID", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/productos/{{productoId}}", "host": ["{{baseUrl}}"], "path": ["productos","{{productoId}}"] } } }
      ]
    },
    {
      "name": "Carritos (protegido)",
      "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ] },
      "item": [
        {
          "name": "Crear carrito",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/carritos/crear", "host": ["{{baseUrl}}"], "path": ["carritos","crear"] },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "Agregar producto al carrito",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/carritos/agregar", "host": ["{{baseUrl}}"], "path": ["carritos","agregar"] },
            "body": { "mode": "raw", "raw": "{\n  \"productoId\": {{productoId}},\n  \"cantidad\": 2\n}" }
          }
        },
        { "name": "Eliminar item del carrito", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/carritos/item/{{carritoItemId}}", "host": ["{{baseUrl}}"], "path": ["carritos","item","{{carritoItemId}}"] } } },
        { "name": "Obtener carrito de usuario", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/carritos/usuario/{{usuarioId}}", "host": ["{{baseUrl}}"], "path": ["carritos","usuario","{{usuarioId}}"] } } },
        { "name": "Total del carrito de usuario", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/carritos/usuario/{{usuarioId}}/total", "host": ["{{baseUrl}}"], "path": ["carritos","usuario","{{usuarioId}}","total"] } } },
        { "name": "Checkout del carrito", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": { "raw": "{{baseUrl}}/carritos/checkout", "host": ["{{baseUrl}}"], "path": ["carritos","checkout"] }, "body": { "mode": "raw", "raw": "{}" } } }
      ]
    }
  ]
}