{
  "info": {
    "name": "Para Tienda API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d1a2b3c4-para-tienda-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4001/api/v1" },
    { "key": "token", "value": "" },
    { "key": "usuarioId", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "carritoItemId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('usuarioId', data.usuario && data.usuario.id);",
                  "  pm.collectionVariables.set('expiresIn', data.expiresIn);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Carritos",
      "auth": {
        "type": "bearer",
        "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
      },
      "item": [
        {
          "name": "Checkout del carrito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/carritos/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["carritos", "checkout"]
            },
            "body": { "mode": "raw", "raw": "{}" }
          },
          "response": []
        }
      ]
    }
  ]
}